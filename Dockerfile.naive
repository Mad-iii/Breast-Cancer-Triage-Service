FROM ubuntu:22.04
RUN apt-get update && apt-get install -y python3 python3-pip
WORKDIR /app
COPY . /app
RUN pip3 install -r requirements-train.txt -r requirements-serve.txt
RUN python3 -m training.train --data-path data/raw/breast_cancer.csv --output-dir artifacts --model-version naive
EXPOSE 8000
CMD python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8000