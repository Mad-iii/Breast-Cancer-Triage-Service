# Docker Hub username (required). Used to name the image: <user>/breast-cancer-triage-api:<tag>
DOCKERHUB_USER=yourusername
# Image tag (also used as MODEL_VERSION build arg)
IMAGE_TAG=1.0.0
# Git commit baked into the image (set with: GIT_SHA=$(git rev-parse --short HEAD))
GIT_SHA=unknown
# Host port that publishes the API (container always listens on 8000)
API_HOST_PORT=8000
# Malignant probability cutoff
DECISION_THRESHOLD=0.5
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO